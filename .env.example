# Copied into app/.env by ./start.sh on first run. Never commit app/.env.
# Generate AUTH_SECRET with: openssl rand -base64 32
# Startup and production notes: README.md

NODE_ENV="development"
LOG_LEVEL="info"

DATABASE_URL="postgresql://ttx:ttx@localhost:5433/ttx?connection_limit=20&pool_timeout=10"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Docker compose overrides AUTH_URL to http://localhost:3080.
# First sign-in with these credentials creates the ADMIN user.
OPERATOR_EMAIL="operator@local"
OPERATOR_PASSWORD="change-me"

# Local `./run.sh docker` sets these so the production image accepts dev defaults
# and seeds DEMO01. Leave false/unset in production.
ALLOW_DEV_DEFAULTS="false"
SEED_DEMO="false"

# Pick a default; the generate form can override per request.
# Prefer configuring keys in the portal at /settings/ai (stored in DB).
# Env vars remain optional fallbacks for Docker bootstrap.
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
GITHUB_TOKEN=""
GITHUB_MODEL="openai/gpt-4.1"
# Ollama — local models (dev). Docker ignores localhost and uses
# http://host.docker.internal:11434/v1 (override with OLLAMA_DOCKER_BASE_URL).
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.1"

# Google Gemini — portal /settings/ai or env fallback
GOOGLE_GENERATIVE_AI_API_KEY=""
# Alias also accepted: GEMINI_API_KEY
GEMINI_MODEL="gemini-2.5-flash"

# Cursor — get a key from https://cursor.com/dashboard/integrations
# Or paste CURSOR_API_KEY in /settings/ai instead of here.
CURSOR_API_KEY=""
CURSOR_MODEL="composer-2.5"
# Optional: OpenAI-compatible proxy (e.g. cursor-openai-api on localhost:8080/v1)
# When set, Cursor uses the proxy instead of the SDK.
# CURSOR_BASE_URL="http://127.0.0.1:8080/v1"

# Optional NVD API key raises rate limits.
NVD_API_KEY=""

# Runtime Stage images + IRP/CCMP. Default is ./data/media (outside public/
# so Next cannot statically serve client documents). Docker compose sets
# MEDIA_ROOT=/data/media (named volume ttx_media).
# MEDIA_ROOT="/data/media"

# In-memory rate limits (join/login/invite/answers/retention). Single-node only.
# Login is per IP + account (10 / 15m). Join is per IP + code (80 / 2m) plus
# a per-IP stuffing cap (120 / 2m). Guest-join Auth.js callbacks do not
# consume the login bucket — see docs/decisions/security.md D2.
# RATE_LIMIT_STORE=memory
# Optional overrides (unset = built-in defaults):
# RATE_LIMIT_LOGIN_MAX="10"
# RATE_LIMIT_JOIN_MAX="80"
# RATE_LIMIT_JOIN_IP_MAX="120"
# RATE_LIMIT_INVITE_MAX="8"
# RATE_LIMIT_ANSWER_MAX="30"
# RATE_LIMIT_RETENTION_MAX="12"

# IRP/CCMP retention sweep (no paid scheduler).
# In-app interval in ms (min 60000). Unset = off. Docker sets 1 hour.
# DOCUMENT_RETENTION_SWEEP_MS="3600000"
# Protect POST/GET /api/internal/retention/run (Bearer or x-retention-secret).
# Leave empty in git; set a long random value in deployment.
# RETENTION_CRON_SECRET=""
# Alias also accepted: CRON_SECRET
# CLI: npm run retention:sweep

# When true (default), completing AI onboarding pulls CISA KEV + alerts.
# Manual "Sync public advisories" / Force re-sync always works.
AUTO_ONBOARD_INTEL="true"

# Passwordless invitation delivery — portal /settings/email or env fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_TLS_MODE="starttls"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="exercises@example.com"
SMTP_FROM_NAME="Cyber Exercise Desk"
SMTP_REPLY_TO=""
