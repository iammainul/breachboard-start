{
  "name": "breachboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:qa": "node ./node_modules/vitest/vitest.mjs run && tsc --noEmit",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test --project=chromium",
    "test:e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui --project=chromium",
    "test:e2e:qa": "bash scripts/qa-engagement-record.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 20261009120000_baseline",
    "attack:seed": "tsx scripts/seed-attack-min.ts",
    "attack:sync": "tsx scripts/sync-attack.ts",
    "library:seed": "tsx scripts/seed-library.ts",
    "demo:reseed": "tsx scripts/reseed-demo.ts",
    "retention:sweep": "tsx scripts/retention-sweep.ts",
    "run": "bash run.sh dev",
    "run:clean": "bash run.sh clean",
    "run:docker": "bash run.sh docker"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.48",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.56",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@cursor/sdk": "^1.0.31",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@prisma/client": "6.16.3",
    "ai": "^7.0.90",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "mammoth": "^1.9.1",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdfjs-dist": "^4.10.38",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "6.16.3",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
